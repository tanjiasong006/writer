    ["/etc/hosts", null],
    ["\\\\server\\a.png", null],
    ["C:/a.png", null],
    ["https://example.com/a.png", null],
    ["data:image/png;base64,AAAA", null],
    ["../assets/%ZZ.png", null],
    ["..", null],
    ["", null]
